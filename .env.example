# XMPP Bot Credentials
XMPP_JID=bot@yourserver.im
XMPP_PASSWORD=your_bot_password

# Default Outbound Line Alias (used when no line prefix is typed)
DEFAULT_LINE=personal

# AAISP SMS API Credentials — Line 1
AA_LINE_1_ALIAS=personal
AA_LINE_1_NUMBER=+44XXXXXXXXX
AA_LINE_1_USERNAME=+44XXXXXXXXX
AA_LINE_1_PASSWORD=your_aa_sms_password
AA_LINE_1_ORIGINATOR=

# AAISP SMS API Credentials — Line 2 (Optional; add AA_LINE_3_*, etc. as needed)
AA_LINE_2_ALIAS=work
AA_LINE_2_NUMBER=+44YYYYYYYYY
AA_LINE_2_USERNAME=+44XXXXXXXXX
AA_LINE_2_PASSWORD=your_second_aa_sms_password
AA_LINE_2_ORIGINATOR=+44YYYYYYYYY

# Security Token for the Inbound Webhook
# Generate a long random string for this
WEBHOOK_TOKEN=replace_with_a_secure_random_string

# The XMPP JID that should receive the incoming SMS notifications
TARGET_USER_JID=user@yourserver.im
